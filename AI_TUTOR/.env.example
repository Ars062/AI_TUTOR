APP_ENV=development

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=

# Neo4j - password MUST match how you started Neo4j.
#   docker run ... -e NEO4J_AUTH=neo4j/your_password neo4j:5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ---------------------------------------------------------------------------
# LIVEKIT - defaults match `livekit-server --dev`
# ---------------------------------------------------------------------------
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------------
# TEXT TUTOR TUNING (all optional - defaults shown)
# ---------------------------------------------------------------------------
LLM_MODEL=openai/gpt-oss-120b
USE_ENSEMBLE=true          # set false to avoid Groq free-tier rate limits
USE_S2A=true
MAX_HISTORY=10
ENABLE_CONTENT_SAFETY=true

# Knowledge graph retrieval
KG_MAX_HOPS=2              # graph traversal depth
KG_EMBED_ANCHORS=true      # embedding-based anchor matching (falls back to keywords)
KG_ANCHOR_TOPK=5
KG_ANCHOR_THRESHOLD=0.35

# Paths (relative to the AI_TUTOR folder)
DOCUMENTS_DIR=data/documents
KG_CSV_PATH=data/knowledge_graph/knowledge_triples.csv
FAISS_INDEX_PATH=data/faiss_index.bin

# ---------------------------------------------------------------------------
# SPEECH
# ---------------------------------------------------------------------------
# STT: any faster-whisper size - tiny/base/small/medium/large-v3
STT_MODEL=base
STT_DEVICE=cpu

# TTS_PROVIDER options:
#   sapi  = Windows built-in voice. Works today, CPU, zero download. DEFAULT.
#   piper = NOT IMPLEMENTED yet - raises NotImplementedError. GPU phase only.
TTS_PROVIDER=sapi
TTS_VOICE=                 # e.g. "Microsoft David Desktop" (blank = system default)

# ---------------------------------------------------------------------------
# VISION
# ---------------------------------------------------------------------------
# Frontend captures a webcam frame every 3s. This value is the backend's
# staleness cutoff for that frame (multiplied internally), not the send rate.
VISION_INTERVAL_SECONDS=3

# ---------------------------------------------------------------------------
# OPTIONAL - PostgreSQL chat history. Leave blank to run without it.
# Matches docker-compose.yml. If unreachable the app logs
# "[memory] PostgreSQL unavailable - in-memory only" and keeps working.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tutor:tutor@localhost:5432/ai_tutor

# ---------------------------------------------------------------------------
# PRIVACY DEFAULTS
# ---------------------------------------------------------------------------
STORE_AUDIO=false
STORE_VIDEO=false
STORE_CAMERA_FRAMES=false
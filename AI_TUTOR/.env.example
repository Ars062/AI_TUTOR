APP_ENV=development
DATABASE_URL=postgresql://tutor:tutor@localhost:5432/ai_tutor

GROQ_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Realtime layer (Milestone 1+)
# Local dev server defaults: key=devkey secret=secret (livekit-server --dev)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Later milestones (provider abstractions, all optional now)
STT_PROVIDER=faster_whisper
TTS_PROVIDER=kokoro
VISION_PROVIDER=qwen_vl
AVATAR_PROVIDER=musetalk
VISION_INTERVAL_SECONDS=2

# Privacy defaults
STORE_AUDIO=false
STORE_VIDEO=false
STORE_CAMERA_FRAMES=false
